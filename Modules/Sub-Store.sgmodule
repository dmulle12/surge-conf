#!name=Sub-Store 订阅管理
#!desc=Sub-Store 订阅转换与管理面板(需自行部署或信任脚本)
#!system=ios
#!author=sub-store-org
#!homepage=https://github.com/sub-store-org/Sub-Store

[General]
force-http-engine-hosts = %APPEND% sub.store

[Rule]
AND,((DOMAIN, sub.store), (OR,((IP-CIDR,127.0.0.1/32),(IP-CIDR6,::1/128)))),REJECT

[Script]
Sub-Store = type=http-request, pattern=^https?:\/\/sub\.store\/((download)|api\/(preview|sync|(utils\/node-info)))\/, script-path=https://raw.githubusercontent.com/sub-store-org/Sub-Store/master/backend/sub-store.min.js, requires-body=true, timeout=120
Sub-Store_1 = type=http-request, pattern=^https?:\/\/sub\.store((\/api\/(utils\/json2yaml|yaml2json))|(\/.*))?, script-path=https://raw.githubusercontent.com/sub-store-org/Sub-Store/master/backend/sub-store.min.js, requires-body=true, timeout=120

[MITM]
hostname = %APPEND% sub.store
